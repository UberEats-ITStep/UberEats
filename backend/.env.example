# -- DJANGO --
DJANGO_SECRET_KEY=key
# -- DATABASE --
# For Neon, prefer DATABASE_URL and remove the POSTGRES_* values below.
# DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
# Keep this at 0 for serverless/scale-to-zero deployments. A small positive value
# can reduce connection setup cost on an always-on, long-running web process.
DATABASE_CONN_MAX_AGE=0
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
# Local development fallback only; never enable in production.
DJANGO_USE_SQLITE=false
# -- Production web security --
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_BEHIND_HTTPS_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# -- BREVO SMTP -- 
SMTP_DEFAULT_FROM_EMAIL=email_here
SMTP_HOST=host_here
SMTP_PORT=port_here
SMTP_USER=user_here
SMTP_PASS=pass_here
SMTP_ENCRYPTION=tls
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_REQUEST_THROTTLE_RATE=5/hour
PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
# -- AI Recommendation --
GROQ_API_KEY=api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# -- Stripe Payment System --
STRIPE_SECRET_KEY=secret_here        
STRIPE_WEBHOOK_SECRET=webhook_here # From the Stripe CLI when you run `stripe listen` locally
PAYMENT_CURRENCY=currency_here # e.g usd, uah.
